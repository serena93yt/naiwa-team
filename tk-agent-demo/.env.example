# 出海宝本地代理配置文件（模板）
# 复制本文件为 .env，然后填入你自己的 OpenAI Key。
# 注意：.env 已被 .gitignore 忽略，不会提交到 GitHub，请放心填写。

# 你的 OpenAI API Key（必填）
OPENAI_API_KEY=

# 可选：自定义接口地址（默认 OpenAI 官方；国内可用中转/镜像填这里）
# OPENAI_ENDPOINT=https://api.openai.com/v1/chat/completions

# 可选：默认模型
# OPENAI_MODEL=gpt-4o-mini

# 出站代理（国内直连不上 api.openai.com 时，走你本机的代理软件端口）
# 常见端口：Clash 7890/7897，V2Ray 10809 等，改成你自己的
PROXY_URL=http://127.0.0.1:7897
